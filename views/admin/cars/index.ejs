<%- include("../../partials/head", { title }) %>
<%- include("../../partials/nav") %>
<%- include("../../partials/flash") %>

<section class="section-header">
  <div>
    <p class="eyebrow">ફ્લીટ મેનેજમેન્ટ</p>
    <h1>રેન્ટલ કેટલોગમાંથી કાર ઉમેરો, ફેરફાર કરો અને દૂર કરો.</h1>
  </div>
  <a class="button" href="/admin/cars/new">કાર ઉમેરો</a>
</section>

<section class="table-shell panel">
  <table>
    <thead>
      <tr>
        <th>કાર</th>
        <th>શહેર</th>
        <th>પ્રકાર</th>
        <th>ટ્રાન્સમિશન</th>
        <th>કિંમત/દિવસ</th>
        <th>સ્થિતિ</th>
        <th>ક્રિયાઓ</th>
      </tr>
    </thead>
    <tbody>
      <% cars.forEach((car) => { %>
        <tr>
          <td><strong><%= car.brand %> <%= car.name %></strong></td>
          <td><%= translateCity(car.city) %></td>
          <td><%= translateCategory(car.category) %></td>
          <td><%= translateTransmission(car.transmission) %></td>
          <td><%= formatCurrency(car.pricePerDay) %></td>
          <td>
            <span class="status-badge <%= car.available ? 'status-accepted' : 'status-rejected' %>">
              <%= translateAvailability(car.available) %>
            </span>
          </td>
          <td>
            <div class="table-actions">
              <a class="button button-secondary" href="/admin/cars/<%= car.id %>/edit">સંપાદિત કરો</a>
              <form action="/admin/cars/<%= car.id %>/delete" method="post">
                <button class="button button-danger" type="submit">ડિલીટ</button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>

<%- include("../../partials/footer") %>
