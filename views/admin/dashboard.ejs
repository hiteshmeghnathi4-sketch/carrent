<%- include("../partials/head", { title }) %>
<%- include("../partials/nav") %>
<%- include("../partials/flash") %>

<section class="section-banner">
  <div>
    <p class="eyebrow">એડમિન ડેશબોર્ડ</p>
    <h1>ફ્લીટ પ્રવૃત્તિ, બુકિંગ લોડ અને આવકને એક નજરમાં જુઓ.</h1>
  </div>
</section>

<section class="dashboard-grid">
  <article class="stat-card stat-card-large">
    <span>કુલ કાર્સ</span>
    <strong><%= stats.cars %></strong>
  </article>
  <article class="stat-card stat-card-large">
    <span>નોંધાયેલા વપરાશકર્તાઓ</span>
    <strong><%= stats.users %></strong>
  </article>
  <article class="stat-card stat-card-large">
    <span>કુલ બુકિંગ્સ</span>
    <strong><%= stats.bookings %></strong>
  </article>
  <article class="stat-card stat-card-large">
    <span>બાકી મંજૂરીઓ</span>
    <strong><%= stats.pendingBookings %></strong>
  </article>
  <article class="stat-card stat-card-large stat-card-accent">
    <span>મંજૂર આવક</span>
    <strong><%= formatCurrency(stats.acceptedRevenue) %></strong>
  </article>
</section>

<section class="admin-panels">
  <article class="panel">
    <div class="panel-heading">
      <div>
        <p class="eyebrow">આવક ડેશબોર્ડ</p>
        <h2>શહેર પ્રમાણે આવક</h2>
      </div>
    </div>

    <div class="bar-list">
      <% const cityEntries = Object.entries(revenueByCity); %>
      <% if (!cityEntries.length) { %>
        <p class="empty-note">એડમિન મંજૂરી આપશે પછી મંજૂર બુકિંગ્સ અહીં દેખાશે.</p>
      <% } %>
      <% const peakRevenue = cityEntries.length ? Math.max(...cityEntries.map((entry) => entry[1])) : 1; %>
      <% cityEntries.forEach(([city, revenue]) => { %>
        <div class="bar-item">
          <div class="bar-item__meta">
            <strong><%= translateCity(city) %></strong>
            <span><%= formatCurrency(revenue) %></span>
          </div>
          <div class="bar-track">
            <span class="bar-fill" style="width: <%= (revenue / peakRevenue) * 100 %>%"></span>
          </div>
        </div>
      <% }) %>
    </div>
  </article>

  <article class="panel">
    <div class="panel-heading">
      <div>
        <p class="eyebrow">તાજેતરની વિનંતીઓ</p>
        <h2>નવીનતમ બુકિંગ્સ</h2>
      </div>
      <a class="button button-secondary" href="/admin/bookings">બધું જુઓ</a>
    </div>

    <div class="table-shell">
      <table>
        <thead>
          <tr>
            <th>વપરાશકર્તા</th>
            <th>કાર</th>
            <th>તારીખો</th>
            <th>સ્થિતિ</th>
            <th>કુલ</th>
          </tr>
        </thead>
        <tbody>
          <% recentBookings.forEach((booking) => { %>
            <tr>
              <td><%= booking.user ? booking.user.name : "અજ્ઞાત વપરાશકર્તા" %></td>
              <td><%= booking.displayCar.brand %> <%= booking.displayCar.name %></td>
              <td><%= formatDateRange(booking.pickupDate, booking.returnDate) %></td>
              <td><span class="status-badge status-<%= booking.status %>"><%= translateStatus(booking.status) %></span></td>
              <td><%= formatCurrency(booking.totalPrice) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </article>
</section>

<%- include("../partials/footer") %>
