<%- include("../partials/head", { title }) %>
<%- include("../partials/nav") %>
<%- include("../partials/flash") %>

<section class="section-header">
  <div>
    <p class="eyebrow">બુકિંગ મોડરેશન</p>
    <h1>બુકિંગ વિનંતીઓને મંજૂર અથવા નકારી દો અને દરેક મુસાફરી વિનંતી જુઓ.</h1>
  </div>
</section>

<div class="filter-pills">
  <a class="pill-link <%= status === 'all' ? 'is-active' : '' %>" href="/admin/bookings">બધા</a>
  <a class="pill-link <%= status === 'pending' ? 'is-active' : '' %>" href="/admin/bookings?status=pending">બાકી</a>
  <a class="pill-link <%= status === 'accepted' ? 'is-active' : '' %>" href="/admin/bookings?status=accepted">મંજૂર</a>
  <a class="pill-link <%= status === 'rejected' ? 'is-active' : '' %>" href="/admin/bookings?status=rejected">નકારેલ</a>
</div>

<section class="stack-list">
  <% if (!bookings.length) { %>
    <article class="empty-state">
      <h2>આ ફિલ્ટર માટે કોઈ બુકિંગ નથી.</h2>
      <p>ફિલ્ટર બદલો અથવા નવી વિનંતી માટે રાહ જુઓ.</p>
    </article>
  <% } %>

  <% bookings.forEach((booking) => { %>
    <article class="panel moderation-card">
      <div class="moderation-card__main">
        <div>
          <p class="eyebrow"><%= booking.user ? booking.user.email : "અજ્ઞાત વપરાશકર્તા" %></p>
          <h3><%= booking.user ? booking.user.name : "અજ્ઞાત વપરાશકર્તા" %></h3>
        </div>
        <span class="status-badge status-<%= booking.status %>"><%= translateStatus(booking.status) %></span>
      </div>

      <div class="detail-grid">
        <div>
          <span>કાર</span>
          <strong><%= booking.displayCar.brand %> <%= booking.displayCar.name %></strong>
        </div>
        <div>
          <span>શહેર</span>
          <strong><%= translateCity(booking.displayCar.city) %></strong>
        </div>
        <div>
          <span>તારીખો</span>
          <strong><%= formatDateRange(booking.pickupDate, booking.returnDate) %></strong>
        </div>
        <div>
          <span>કુલ</span>
          <strong><%= formatCurrency(booking.totalPrice) %></strong>
        </div>
      </div>

      <% if (booking.note) { %>
        <p class="booking-note"><strong>નોંધ:</strong> <%= booking.note %></p>
      <% } %>

      <% if (booking.status === "pending") { %>
        <div class="table-actions">
          <form action="/admin/bookings/<%= booking.id %>/status" method="post">
            <input type="hidden" name="status" value="accepted" />
            <button class="button" type="submit">મંજૂર કરો</button>
          </form>
          <form action="/admin/bookings/<%= booking.id %>/status" method="post">
            <input type="hidden" name="status" value="rejected" />
            <button class="button button-danger" type="submit">નકારી દો</button>
          </form>
        </div>
      <% } %>
    </article>
  <% }) %>
</section>

<%- include("../partials/footer") %>
