<%- include("partials/head", { title }) %>
<%- include("partials/nav") %>
<%- include("partials/flash") %>

<section class="hero-panel">
  <div class="hero-copy">
    <form class="hero-search" action="/cars" method="get">
      <label for="city">શહેર પ્રમાણે શોધો</label>
      <div class="hero-search__row">
        <input
          id="city"
          name="city"
          type="text"
          list="city-options"
          placeholder="દિલ્હી, મુંબઈ, બેંગલુરુ..."
        />
        <datalist id="city-options">
          <% cities.forEach((city) => { %>
            <option value="<%= city %>"></option>
          <% }) %>
        </datalist>
        <button class="button" type="submit">કાર્સ જુઓ</button>
      </div>
    </form>
  </div>

  <div class="hero-aside">
    <div class="stat-stack">
      <article class="stat-card">
        <span>ફ્લીટ</span>
        <strong><%= stats.cars %> કાર્સ</strong>
      </article>
      <article class="stat-card">
        <span>શહેરો</span>
        <strong><%= stats.cities %> સ્થળો</strong>
      </article>
      <article class="stat-card">
        <span>બુકિંગ્સ</span>
        <strong><%= stats.bookings %> નોંધાયેલ</strong>
      </article>
    </div>

  </div>
</section>

<section class="section-header">
  <div>
    <p class="eyebrow">વિશેષ ફ્લીટ</p>
    <h2>થોડા ક્લિકમાં શોધી, સરખાવી અને બુક કરી શકાય તેવી કાર્સ.</h2>
  </div>
  <a class="button button-secondary" href="/cars">બધી કાર્સ જુઓ</a>
</section>

<section class="card-grid">
  <% featuredCars.forEach((car) => { %>
    <article class="car-card">
      <img src="<%= car.image %>" alt="<%= car.name %>" />
      <div class="car-card__body">
        <div class="car-card__topline">
          <span class="pill"><%= translateCity(car.city) %></span>
          <span class="pill pill-soft"><%= translateCategory(car.category) %></span>
        </div>
        <h3><%= car.name %></h3>
        <p><%= translateDescription(car.description) %></p>
        <div class="spec-row">
          <span><%= translateTransmission(car.transmission) %></span>
          <span><%= translateFuel(car.fuel) %></span>
          <span><%= formatSeats(car.seats) %></span>
        </div>
        <div class="price-row">
          <strong><%= formatCurrency(car.pricePerDay) %></strong>
          <a class="button button-secondary" href="/cars/<%= car.id %>">વિગતો જુઓ</a>
        </div>
      </div>
    </article>
  <% }) %>
</section>

<%- include("partials/footer") %>
