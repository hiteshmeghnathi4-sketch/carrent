<%- include("../partials/head", { title }) %>
<%- include("../partials/nav") %>
<%- include("../partials/flash") %>

<section class="section-banner">
  <div>
    <p class="eyebrow">કાર્સ જુઓ</p>
    <h1>શહેર પ્રમાણે ફ્લીટ શોધો અને તમારી મુસાફરી માટે યોગ્ય કાર સરખાવો.</h1>
  </div>

  <form class="filter-bar panel" action="/cars" method="get">
    <label>
      શહેર
      <input
        type="text"
        name="city"
        list="city-options"
        value="<%= filters.city %>"
        placeholder="શહેર લખો"
      />
      <datalist id="city-options">
        <% cities.forEach((city) => { %>
          <option value="<%= city %>"></option>
        <% }) %>
      </datalist>
    </label>
    <button class="button" type="submit">શોધો</button>
    <a class="button button-secondary" href="/cars">રીસેટ</a>
  </form>
</section>

<section class="results-meta">
  <p><strong><%= cars.length %></strong> કાર્સ ઉપલબ્ધ છે <%= filters.city ? `${translateCity(filters.city)} માટે` : "બધા શહેરોમાં" %>.</p>
</section>

<section class="card-grid">
  <% if (!cars.length) { %>
    <article class="empty-state">
      <h2>આ શહેર માટે હજી કોઈ કાર મળી નથી.</h2>
      <p>બીજું શહેર અજમાવો અથવા સંપૂર્ણ ફ્લીટ જોવા માટે શોધ સાફ કરો.</p>
    </article>
  <% } %>

  <% cars.forEach((car) => { %>
    <article class="car-card">
      <img src="<%= car.image %>" alt="<%= car.name %>" />
      <div class="car-card__body">
        <div class="car-card__topline">
          <span class="pill"><%= translateCity(car.city) %></span>
          <span class="pill pill-soft"><%= translateCategory(car.category) %></span>
        </div>
        <h3><%= car.brand %> <%= car.name %></h3>
        <p><%= translateDescription(car.description) %></p>
        <div class="spec-row">
          <span><%= translateTransmission(car.transmission) %></span>
          <span><%= translateFuel(car.fuel) %></span>
          <span><%= formatSeats(car.seats) %></span>
        </div>
        <div class="price-row">
          <strong><%= formatCurrency(car.pricePerDay) %> / દિવસ</strong>
          <a class="button button-secondary" href="/cars/<%= car.id %>">વિગતો</a>
        </div>
      </div>
    </article>
  <% }) %>
</section>

<%- include("../partials/footer") %>
