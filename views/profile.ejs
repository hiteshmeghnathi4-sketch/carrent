<%- include("partials/head", { title }) %>
<%- include("partials/nav") %>
<%- include("partials/flash") %>

<section class="profile-layout">
  <div class="profile-summary">
    <p class="eyebrow">પ્રોફાઇલ મેનેજમેન્ટ</p>
    <h1>તમારી વિગતો અપડેટ રાખો અને બુકિંગ પ્રવૃત્તિ પર નજર રાખો.</h1>
    <div class="mini-stats">
      <article class="stat-card">
        <span>કુલ બુકિંગ્સ</span>
        <strong><%= bookingSummary.total %></strong>
      </article>
      <article class="stat-card">
        <span>મંજૂર</span>
        <strong><%= bookingSummary.accepted %></strong>
      </article>
      <article class="stat-card">
        <span>બાકી</span>
        <strong><%= bookingSummary.pending %></strong>
      </article>
    </div>
  </div>

  <form class="panel form-panel" action="/profile" method="post">
    <label>
      સંપૂર્ણ નામ
      <input type="text" name="name" value="<%= user.name %>" required />
    </label>

    <label>
      ઇમેઇલ
      <input type="email" name="email" value="<%= user.email %>" required />
    </label>

    <div class="split-fields">
      <label>
        મોબાઇલ નંબર
        <input type="text" name="phone" value="<%= user.phone %>" required />
      </label>

      <label>
        શહેર
        <input type="text" name="city" value="<%= user.city %>" required />
      </label>
    </div>

    <label>
      નવો પાસવર્ડ
      <input type="password" name="password" placeholder="હાલનો પાસવર્ડ જાળવવા માટે ખાલી રાખો" />
    </label>

    <button class="button" type="submit">ફેરફાર સંગ્રહિત કરો</button>
  </form>
</section>

<%- include("partials/footer") %>
