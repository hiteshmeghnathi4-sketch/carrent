<%- include("../partials/head", { title }) %>
<%- include("../partials/nav") %>
<%- include("../partials/flash") %>

<section class="section-banner">
  <div>
    <p class="eyebrow">બુકિંગ ઇતિહાસ</p>
    <h1>બધી વિનંતીઓ અને મંજૂરીઓને એક જ સમયરેખામાં જુઓ.</h1>
  </div>
</section>

<section class="stack-list">
  <% if (!bookings.length) { %>
    <article class="empty-state">
      <h2>હજુ સુધી કોઈ બુકિંગ નથી.</h2>
      <p>ફ્લીટ જુઓ અને તમારી પ્રથમ વિનંતી મોકલો.</p>
      <a class="button" href="/cars">કાર્સ જુઓ</a>
    </article>
  <% } %>

  <% bookings.forEach((booking) => { %>
    <article class="booking-card">
      <img src="<%= booking.displayCar.image %>" alt="<%= booking.displayCar.name %>" />
      <div class="booking-card__body">
        <div class="booking-card__topline">
          <div>
            <p class="eyebrow">બુક કરેલી કાર</p>
            <h3><%= booking.displayCar.brand %> <%= booking.displayCar.name %></h3>
          </div>
          <span class="status-badge status-<%= booking.status %>"><%= translateStatus(booking.status) %></span>
        </div>

        <div class="detail-grid">
          <div>
            <span>શહેર</span>
            <strong><%= translateCity(booking.displayCar.city) %></strong>
          </div>
          <div>
            <span>તારીખો</span>
            <strong><%= formatDateRange(booking.pickupDate, booking.returnDate) %></strong>
          </div>
          <div>
            <span>અવધિ</span>
            <strong><%= formatDays(booking.days) %></strong>
          </div>
          <div>
            <span>કુલ</span>
            <strong><%= formatCurrency(booking.totalPrice) %></strong>
          </div>
        </div>

        <% if (booking.note) { %>
          <p class="booking-note"><strong>નોંધ:</strong> <%= booking.note %></p>
        <% } %>
      </div>
    </article>
  <% }) %>
</section>

<%- include("../partials/footer") %>
