<%- include("../partials/head", { title }) %>
<%- include("../partials/nav") %>
<%- include("../partials/flash") %>

<section class="form-shell">
  <div class="form-shell__intro">
    <p class="eyebrow">Create account</p>
    <h1>Start browsing and request your next ride.</h1>
    <p>Profiles include booking history and editable account information from day one.</p>
  </div>

  <form class="panel form-panel" action="/signup" method="post">
    <label>
      Full name
      <input type="text" name="name" placeholder="Aarav Mehta" required />
    </label>

    <label>
      Email
      <input type="email" name="email" placeholder="name@example.com" required />
    </label>

    <div class="split-fields">
      <label>
        Phone
        <input type="text" name="phone" placeholder="9876543210" required />
      </label>

      <label>
        City
        <input type="text" name="city" placeholder="Bengaluru" required />
      </label>
    </div>

    <label>
      Password
      <input type="password" name="password" placeholder="Minimum 6 characters" required />
    </label>

    <button class="button" type="submit">Create account</button>
    <p class="inline-link">Already registered? <a href="/login">Login here</a></p>
  </form>
</section>

<%- include("../partials/footer") %>
