<%- include("../partials/head", { title }) %>
<%- include("../partials/nav") %>
<%- include("../partials/flash") %>

<section class="form-shell">

  <form class="panel form-panel" action="/signup" method="post">
    <label>
      સંપૂર્ણ નામ
      <input type="text" name="name" placeholder="આરવ મહેતા" required />
    </label>

    <label>
      ઇમેઇલ
      <input type="email" name="email" placeholder="name@example.com" required />
    </label>

    <div class="split-fields">
      <label>
        મોબાઇલ નંબર
        <input type="text" name="phone" placeholder="9876543210" required />
      </label>

      <label>
        શહેર
        <input type="text" name="city" placeholder="બેંગલુરુ" required />
      </label>
    </div>

    <label>
      પાસવર્ડ
      <input type="password" name="password" placeholder="ઓછામાં ઓછા 6 અક્ષર" required />
    </label>

    <button class="button" type="submit">એકાઉન્ટ બનાવો</button>
    <p class="inline-link">પહેલેથી નોંધાયેલા છો? <a href="/login">અહીં લોગિન કરો</a></p>
  </form>
</section>

<%- include("../partials/footer") %>
