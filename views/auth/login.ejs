<%- include("../partials/head", { title }) %>
<%- include("../partials/nav") %>
<%- include("../partials/flash") %>

<section class="form-shell">
  <div class="form-shell__intro">
    <p class="eyebrow">ફરી સ્વાગત છે</p>
    <h1>કાર બુક કરવા અથવા ફ્લીટ સંચાલિત કરવા માટે લોગિન કરો.</h1>
    <p>બંને ભૂમિકાઓ ઝડપી જોવા માટે હોમ પેજ પર આપેલ ડેમો એકાઉન્ટ્સનો ઉપયોગ કરો.</p>
  </div>

  <form class="panel form-panel" action="/login" method="post">
    <label>
      ઇમેઇલ
      <input type="email" name="email" placeholder="name@example.com" required />
    </label>

    <label>
      પાસવર્ડ
      <input type="password" name="password" placeholder="********" required />
    </label>

    <button class="button" type="submit">લોગિન</button>
    <p class="inline-link">એકાઉન્ટ નથી? <a href="/signup">હમણાં બનાવો</a></p>
  </form>
</section>

<%- include("../partials/footer") %>
