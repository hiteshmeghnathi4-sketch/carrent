<header class="site-header">
  <a class="brand-mark" href="/">
    <span class="brand-mark__eyebrow">શહેરની ફ્લીટ</span>
    <span class="brand-mark__title">DriveMint</span>
  </a>

  <nav class="site-nav">
    <a href="/" class="<%= currentPath === '/' ? 'is-active' : '' %>">હોમ</a>
    <a href="/cars" class="<%= currentPath.startsWith('/cars') ? 'is-active' : '' %>">કાર્સ</a>

    <% if (user && !isAdmin) { %>
      <a href="/bookings" class="<%= currentPath === '/bookings' ? 'is-active' : '' %>">બુકિંગ્સ</a>
      <a href="/profile" class="<%= currentPath === '/profile' ? 'is-active' : '' %>">પ્રોફાઇલ</a>
    <% } %>

    <% if (isAdmin) { %>
      <a href="/admin/cars" class="<%= currentPath.startsWith('/admin/cars') ? 'is-active' : '' %>">કાર મેનેજમેન્ટ</a>
      <a href="/admin/bookings" class="<%= currentPath.startsWith('/admin/bookings') ? 'is-active' : '' %>">બુકિંગ્સ</a>
      <a href="/admin/users" class="<%= currentPath.startsWith('/admin/users') ? 'is-active' : '' %>">વપરાશકર્તાઓ</a>
    <% } %>
  </nav>

  <div class="site-actions">
    <% if (user) { %>
      <span class="user-pill"><%= user.name %></span>
      <form action="/logout" method="post">
        <button class="button button-secondary" type="submit">લોગઆઉટ</button>
      </form>
    <% } else { %>
      <a class="button button-secondary" href="/login">લોગિન</a>
      <a class="button" href="/signup">સાઇન અપ</a>
    <% } %>
  </div>
</header>
